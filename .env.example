# Copie para .env.local e preencha. NUNCA versione chaves reais.

# URL pública do app (usada nos QR Codes e no manifesto)
URL_BASE=https://guia-dourado.vercel.app

# Supabase (Central, pedidos de ajuda, status de equipamentos) — ADR-0008
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (Route Handlers). Ignora RLS: jamais exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Tradução em nuvem (último recurso da cascata) — ADR-0009 / ADR-0011
# valores: nenhum | claude
TRADUCAO_PROVEDOR=nenhum
ANTHROPIC_API_KEY=
# Padrão documentado: claude-opus-5-5. Alternativa de menor custo, a critério da equipe: claude-haiku-5-5
LLM_MODEL=claude-opus-5-5
# Teto mensal de gasto com tradução em nuvem (US$). Ao atingir, só frases prontas (RNF-16).
TRADUCAO_ORCAMENTO_MENSAL_USD=10

# Videochamada com intérprete de Libras (parceria) — RF-17. Ex.: link da central contratada.
URL_INTERPRETE_LIBRAS=
